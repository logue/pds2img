{
  "extends": "@tsconfig/node-lts/tsconfig.json",
  "include": ["env.d.ts", "src/**/*"],
  "exclude": ["**/node_modules", "**/.*/", "src/**/__tests__/*"],
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "isolatedModules": true,
    // The library runs in both Node.js and browsers (Blob, fetch, DOMParser, File System Access API).
    "lib": ["ES2024", "ESNext.Array", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    /* modules */
    "module": "esnext",
    "moduleResolution": "bundler",
    /* type checking */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"]
    },
    "resolveJsonModule": true,
    "rootDir": "src",
    "tsBuildInfoFile": "./.rstack/tsconfig.rslib.tsbuildinfo",
    "useDefineForClassFields": true,
    "types": ["rstack/types", "node"]
  }
}
